# Brújula, the Nodalix web browser (Rust, WebKit, Nodalia Design Language), built from
# getnodalia/brujula pinned to a verified release commit. The independent
# browser package version is not tied to the Nodalix OS VERSION.
# Standalone build and signed publication: .github/workflows/brujula-package.yml.
pkgname=nodalix-brujula
pkgver=0.10.0
pkgrel=1
_brujula_commit=0d0b908c9b01c978ebed6e556519bbcc6d64d97e
pkgdesc='Brújula: the default web browser of Nodalix OS (WebKit, vertical tabs, ad blocker, passwords)'
arch=('x86_64')
url='https://github.com/getnodalia/brujula'
license=('GPL-3.0-or-later')
depends=('gtk4' 'webkitgtk-6.0' 'libsoup3' 'hicolor-icon-theme' 'dbus' 'systemd-libs' 'libsecret')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=('bluez: passkeys with the phone (QR code and Bluetooth)')
provides=('brujula' 'webbrowser')
conflicts=('brujula')
replaces=('brujula')
# makepkg verifies the exact Git commit object when fetching a VCS source.
# VCS sources cannot have static archive checksums: never use a floating tag or branch.
source=("brujula::git+https://github.com/getnodalia/brujula.git#commit=$_brujula_commit")
sha256sums=('SKIP')
# The C code of its dependencies (SQLite and ring) is compiled by cc with makepkg's -flto and then
# linked by lld, which cannot read those objects: undefined sqlite3_* and ring_core_* symbols.
# The native apps (nodalix-native-apps) build without LTO for the same reason.
options=('!lto' '!debug')

prepare() {
  cd "$srcdir/brujula"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/brujula"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p brujula
}

package() {
  cd "$srcdir/brujula"
  install -Dm755 "$srcdir/target/release/brujula" "$pkgdir/usr/bin/brujula"
  install -Dm644 packaging/dev.danielmiguelt.Brujula.desktop \
    "$pkgdir/usr/share/applications/dev.danielmiguelt.Brujula.desktop"
  install -Dm644 packaging/icons/dev.danielmiguelt.Brujula.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.danielmiguelt.Brujula.svg"
  # Default browser. The session is XDG_CURRENT_DESKTOP=GNOME; this file sits in the config
  # directory so it does not clash with gnome-mimeapps.list in the data directory.
  install -Dm644 /dev/stdin "$pkgdir/etc/xdg/gnome-mimeapps.list" <<'MIME'
[Default Applications]
text/html=dev.danielmiguelt.Brujula.desktop
application/xhtml+xml=dev.danielmiguelt.Brujula.desktop
x-scheme-handler/http=dev.danielmiguelt.Brujula.desktop
x-scheme-handler/https=dev.danielmiguelt.Brujula.desktop
MIME
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
